{
  "name": "piano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI to start or continue pi threads across projects and worktrunk worktrees, each thread a long-lived pi RPC process.",
  "scripts": {
    "start": "node server/main.ts",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PIANO_ALLOWED_ORIGINS=${PIANO_ALLOWED_ORIGINS:-http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173} node --watch server/main.ts",
    "dev:web": "npm --prefix web run dev --",
    "build": "npm --prefix web run build",
    "test": "node --test --import ./test/setup.ts 'test/**/*.test.ts'",
    "test:browser": "node test/browser/start-session.mjs && node test/browser/open-session.mjs && node test/browser/transcript-rows.mjs",
    "typecheck": "tsc -p tsconfig.json && npm --prefix web run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives && stylelint \"web/src/**/*.css\" && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-claude-code": "https://codeload.github.com/earendil-works/pi-claude-code/tar.gz/d5b5e04c314d3452d357174d16d10dda34daa2d2",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-schema": "^1.5.0",
    "@effect/platform-node": "^4.1.2",
    "effect": "^4.1.2",
    "file-type": "^22.2.0",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.5",
    "@types/css-tree": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "husky": "9.1.7",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "stylelint": "^17.16.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "~7.0.2"
  },
  "workspaces": [
    "web",
    "extensions/radius-artifacts"
  ],
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.3"
    },
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "mermaid": {
      "katex": "^0.18.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "fsevents": false,
    "protobufjs": false
  }
}
