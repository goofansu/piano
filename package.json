{
  "name": "piano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI to start or continue pi threads across projects and worktrunk worktrees, each thread a long-lived pi RPC process.",
  "scripts": {
    "start": "node server/main.ts",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && npm --prefix web run typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@effect/platform-node": "4.0.0-rc.118",
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "web"
  ],
  "overrides": {
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "mermaid": {
      "katex": "^0.18.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "fsevents": false,
    "protobufjs": false
  }
}
