{
  "name": "piano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI to start or continue pi threads across projects and worktrunk worktrees, each thread a long-lived pi RPC process.",
  "scripts": {
    "start": "node server/main.ts",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node --test --import ./test/setup.ts 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && npm --prefix web run typecheck",
    "lint": "biome check . && npm run lint:tailwind",
    "lint:tailwind": "eslint --no-inline-config --max-warnings 0 web/src",
    "lint:fix": "biome check --write . && npm run lint:tailwind",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@effect/platform-node": "^4.0.2",
    "effect": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "husky": "9.1.7",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "web"
  ],
  "overrides": {
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "mermaid": {
      "katex": "^0.18.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "fsevents": false,
    "protobufjs": false
  }
}
