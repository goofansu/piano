{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@shared/*": ["./shared/*.ts"]
    },
    "lib": [
      "es2023"
    ]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts"
  ]
}
