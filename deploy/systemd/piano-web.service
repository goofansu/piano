[Unit]
Description=Piano built UI and session connection proxy
Wants=piano.service
Requires=piano-web.socket
After=network.target piano.service piano-web.socket

[Service]
Type=simple
User=exedev
Group=exedev
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:8001
NoNewPrivileges=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
